{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "..",
    "composite": false,
    "noEmit": false,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../node_modules/@types",
      "../src/types"
    ]
  },
  "include": [
    "../src/**/*.stories.tsx",
    "../src/**/*.stories.ts",
    "../src/**/*.stories.mdx",
    "../docs/stories/**/*.stories.tsx",
    "../docs/stories/**/*.stories.ts",
    "../docs/stories/**/*.stories.mdx",
    "./*.ts",
    "./*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
