{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "baseUrl": "../../../../",
    "tsBuildInfoFile": "../../../../node_modules/.cache/tsbuildinfo/media-block/image-block/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["src/*"],
      "@vibing-ai/block-kit": ["src/index"],
      "@vibing-ai/block-kit/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "types": ["node", "jest", "@testing-library/jest-dom"]
  },
  "include": [
    "./**/*.tsx",
    "./**/*.ts",
    "../../**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    { "path": "../tsconfig.json" }
  ]
}
